  dialogueManager: {fileID: 1992984982767785019}
  fadeBlackImage: {fileID: 4567896713528128631}
  shakeTarget: {fileID: 0}
  text1: "\uB4DC\uB514\uC5B4\u2026 \uC774 \uC9C0\uC625 \uAC19\uC740 \uAC8C\uC784\uC5D0\uC11C
    \uBC97\uC5B4\uB0AC\uAD70\u2026"
  text2: "\uCD95\uD558\uD55C\uB2E4\u2026 \uC774\uC81C \uB108\uC758 \uCC28\uB840\uB2E4\u2026
    \uB9C8\uC74C\uAECF \uC990\uAE30\uB3C4\uB85D\u2026"
  text3: "\uADF8\uAC8C \uBB34\uC2A8\u2026? \uB09C \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC08\uAC70\uB2E4!
    \uC774\uB534 \uAC8C\uC784\uC5D0\uB294 \uAD00\uC2EC\uC5C6\uC5B4!"
  text4: "\uB098\uB3C4... \uB204\uAD70\uAC00\uB97C \uD76C\uC0DD\uC2DC\uCF1C \uBA48\uCDB0\uC57C\uB9CC
    \uD574..."
  fadeDuration: 3
  shakeIntensity: 0.05
